# Production environment template. Copy to .env.production and fill in real
# secrets (never commit the filled file). Validated by `php artisan app:validate-env`.

APP_NAME=BizOps
APP_ENV=production
APP_KEY=            # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

# Central (SaaS) domain and admin console host. Tenants live on subdomains
# (*.example.com), so the DNS zone needs an A/AAAA record for the apex plus a
# wildcard record for tenant subdomains.
CENTRAL_DOMAIN=example.com
ADMIN_DOMAIN=dashboard.example.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- PostgreSQL (managed instance recommended) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bizops_central
DB_USERNAME=bizops
DB_PASSWORD=

# --- Queue ---
# The jobs table MUST stay pinned to the central connection so a worker that
# boots into a tenant still reads jobs from the right database.
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=pgsql

# --- Cache / session (shared Redis) ---
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.example.com

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Object storage (S3-compatible) for tenant files & backups ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

# --- Error tracking / monitoring ---
# SENTRY_LARAVEL_DSN=
